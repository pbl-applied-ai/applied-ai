{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_bundle.schema.json",
  "title": "EvidenceBundle",
  "description": "추출 파이프라인 1~4단계의 결과. 5단계(구조화 모델)의 입력이자 학습 예제의 입력이다.",
  "type": "object",
  "required": ["schema_version", "video_id", "source", "run", "segments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "video_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "영상 단위 식별자. 학습·평가 분할의 기준"
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["youtube_shorts", "upload"] },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "channel": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "run": {
      "type": "object",
      "required": ["run_id", "created_at", "stages"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "stages": {
          "type": "object",
          "description": "단계별 도구·모델·설정 버전. 예: {\"asr\": {\"tool\": \"whisper\", \"version\": \"large-v3\"}}",
          "additionalProperties": {
            "type": "object",
            "required": ["tool", "version"],
            "properties": {
              "tool": { "type": "string" },
              "version": { "type": "string" },
              "config": { "type": "object" }
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["id", "type", "text"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+-[0-9]+$",
          "description": "레시피 근거가 참조하는 키. 예: asr-3, ocr-12, desc-0"
        },
        "type": { "enum": ["title", "description", "asr", "ocr"] },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["asr", "ocr"] } } },
          "then": { "required": ["start_ms", "end_ms"] }
        }
      ]
    }
  }
}
