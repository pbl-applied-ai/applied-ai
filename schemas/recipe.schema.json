{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "Recipe",
  "description": "5~6단계 출력(RecipeDraft)과 정답 레시피가 같은 형식을 쓴다. 평가는 두 파일을 그대로 비교한다.",
  "type": "object",
  "required": ["schema_version", "video_id", "title", "ingredients", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "servings_raw": {
      "type": ["string", "null"],
      "description": "영상에 나온 그대로(예: \"2인분\"). 없으면 null"
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ingredient" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]+-[0-9]+$" },
      "uniqueItems": true,
      "description": "evidence bundle의 segment id 목록"
    },
    "ingredient": {
      "type": "object",
      "required": ["name", "amount_raw", "amount_status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "라벨링 가이드의 재료 이름 규칙을 따른 이름" },
        "name_raw": { "type": "string", "description": "영상 표기가 name과 다를 때만" },
        "amount_raw": {
          "type": ["string", "null"],
          "description": "영상에 나온 분량 원문(예: \"2큰술\", \"한 줌\"). 미확인이면 null"
        },
        "amount_status": { "enum": ["confirmed", "unconfirmed"] },
        "optional": { "type": "boolean", "default": false },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "amount_status": { "const": "confirmed" } } },
          "then": {
            "properties": {
              "amount_raw": { "type": "string", "minLength": 1 },
              "evidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "amount_status": { "const": "unconfirmed" } } },
          "then": { "properties": { "amount_raw": { "type": "null" } } }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["order", "text", "evidence"],
      "additionalProperties": false,
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
