# 복사해서 web/.env.local 로 사용 (커밋 금지)
# 비워 두면 전부 목 API(src/lib/api/mock.ts)로 동작해요.
# 채우면 링크 넣기·처리 중·결과(createJob·getJob·getRun)만 실제 Supabase로 가요. 로그인·저장·레시피북은 아직 목(KAN-22~24).
# anon 키는 브라우저에 공개되는 키예요. service_role 키는 절대 여기 넣지 않아요(워커 전용).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 영상 파일 업로드(KAN-49). Supabase를 쓸 때는 배포 DB에 uploads 버킷·create_upload_job이 들어간 뒤 true로 켜요.
# 목 모드(위 두 값이 비어 있음)에서는 이 값과 상관없이 켜져요.
NEXT_PUBLIC_UPLOAD_ENABLED=
